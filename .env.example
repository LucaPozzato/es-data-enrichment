# Elasticsearch
ES_HOST=http://localhost:9200
ES_USER=
ES_PASS=
# Common patterns: suricata-*, filebeat-*, logs-suricata.eve-* (Elastic Agent data streams)
ES_INDEX=suricata-*

# VirusTotal (free: 4 req/min, 500/day)
VT_API_KEY=your_virustotal_api_key_here

# AbuseIPDB (free: 1000 req/day)
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
